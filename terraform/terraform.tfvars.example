# GCP Project Configuration
project_id  = "sumifu"
region      = "asia-northeast1"
zone        = "asia-northeast1-a"
environment = "prod"

# Database Configuration
db_tier = "db-f1-micro" # または db-g1-small, db-custom-2-7680
db_name = "real_estate"
db_user = "sumifu"

# Cloud Run Job Configuration
crawler_cpu     = "2"
crawler_memory  = "4Gi"
crawler_timeout = "86400s"

# Schedule (0 16 * * * is JST 01:00)
schedule_cron = "0 16 * * *"
