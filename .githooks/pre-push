#!/bin/sh
# .githooks/pre-push
# Enforce GitHub Issue association & SonarCloud local guardrail before pushing to remote

set -e

export MSYS_NO_PATHCONV=1
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-realestate_crawler}"

zero="0000000000000000000000000000000000000000"

run_pre_pr_check() {
    target_branch="$1"
    target_sha="$2"
    toplevel=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    common_dir=$(git rev-parse --git-common-dir 2>/dev/null || echo "$toplevel/.git")
    main_root=$(cd "$common_dir/.." && pwd -P 2>/dev/null || echo "$toplevel")
    
    rel_path=""
    case "$toplevel" in
        *".worktrees"*)
            wt_name=$(basename "$toplevel")
            rel_path=".worktrees/$wt_name"
            ;;
    esac

    if command -v docker >/dev/null 2>&1; then
        if [ -n "$rel_path" ]; then
            # In-repo worktree mounted under /app/.worktrees/...
            docker compose --project-directory "$main_root" exec -T -w "/app/$rel_path" app python src/crawler/scripts/ops/pre_pr_check.py --diff --branch "$target_branch" --sha "$target_sha"
        elif [ "$toplevel" = "$main_root" ]; then
            # Main checkout mapped to /app
            docker compose --project-directory "$main_root" exec -T app python src/crawler/scripts/ops/pre_pr_check.py --diff --branch "$target_branch" --sha "$target_sha"
        else
            # External worktree is outside the compose mount; inspect that checkout on the host
            python3 src/crawler/scripts/ops/pre_pr_check.py --diff --branch "$target_branch" --sha "$target_sha"
        fi
    else
        python3 src/crawler/scripts/ops/pre_pr_check.py --diff --branch "$target_branch" --sha "$target_sha"
    fi
}

while read -r local_ref local_sha remote_ref remote_sha
do
    # Skip branch deletion
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi

    # Only validate branch pushes, allowing tag pushes and other non-branch refs to proceed
    case "$local_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    # Extract branch name from ref
    branch=$(echo "$local_ref" | sed 's#^refs/heads/##')

    # Allow master/production maintenance operations if needed, but enforce for feature/fix branches
    if [ "$branch" = "production" ]; then
        echo ""
        echo "================================================================================"
        echo "⛔ [PRE-PUSH REJECTED] 'production' ブランチへの直接プッシュは禁止されています。"
        echo "================================================================================"
        echo ""
        exit 1
    fi

    if [ "$branch" = "master" ]; then
        continue
    fi

    # 1. Try extracting issue number from branch name (e.g. feature/12-xxx, fix/issue-34-xxx, cursor/fix-312-xxx-c318)
    issue_num=$(echo "$branch" | grep -oE '(issue[-/_]|#)?([0-9]+)' | grep -oE '[0-9]+' | head -n 1 || true)

    # 2. Try extracting issue number from the commit message
    if [ -z "$issue_num" ]; then
        commit_msg=$(git log -1 --pretty=%B "$local_sha" 2>/dev/null || true)
        issue_num=$(echo "$commit_msg" | grep -oE '(#[0-9]+|issue[ -]#[0-9]+|issue[ -][0-9]+)' | grep -oE '[0-9]+' | head -n 1 || true)
    fi

    if [ -z "$issue_num" ]; then
        echo ""
        echo "================================================================================"
        echo "⛔ [PRE-PUSH REJECTED] GitHub Issue が紐付けられていません。"
        echo "ブランチ名またはコミットメッセージに有効な Issue 番号を含めてください。"
        echo ""
        echo "  対象ブランチ: $branch"
        echo ""
        echo "  命名規則の例:"
        echo "    ブランチ名: feature/<issue_num>-<概要> (例: feature/12-add-login)"
        echo "                fix/<issue_num>-<概要>     (例: fix/34-fix-parser)"
        echo "    コミット:   feat: add login (#12)"
        echo ""
        echo "GitHub Issues にチケットを起票後、ブランチ名またはコミットを変更して再実行してください。"
        echo "================================================================================"
        echo ""
        exit 1
    fi

    # 3. Check if the issue exists on GitHub using gh CLI
    if ! command -v gh >/dev/null 2>&1; then
        echo ""
        echo "================================================================================"
        echo "⛔ [PRE-PUSH REJECTED] 'gh' (GitHub CLI) がインストールされていないか、PATHに存在しません。"
        echo "Issue存在確認をバイパスすることは許可されていません。'gh' CLI を導入してください。"
        echo "================================================================================"
        echo ""
        exit 1
    fi

    echo "🔍 Issue #$issue_num の存在を検証中..."
    if ! gh issue view "$issue_num" >/dev/null 2>&1; then
        echo ""
        echo "================================================================================"
        echo "⛔ [PRE-PUSH REJECTED] Issue #$issue_num は GitHub 上に存在しません。"
        echo "GitHub Issues で該当の Issue を作成してからプッシュしてください。"
        echo "================================================================================"
        echo ""
        exit 1
    fi
    echo "✅ Issue #$issue_num の存在を確認しました。"

    # 4. GitHub Issue Acceptance Criteria Guardrail
    echo "🔍 Issue #$issue_num のアクセプタンスクライテリア (受入基準) を検証中..."
    if [ "$SKIP_ISSUE_CHECK" = "1" ] || [ "$SKIP_ISSUE_CHECK" = "true" ] || echo "$branch" | grep -qE '^cursor/'; then
        echo "⚠️  自動化エージェントブランチまたは SKIP_ISSUE_CHECK が有効なため、受入基準ローカル検証をパスします。"
    else
        if command -v docker >/dev/null 2>&1; then
            CHECK_CRITERIA_CMD="docker compose exec -T app python src/crawler/scripts/debug_tools/check_issue_criteria.py --issue $issue_num"
        else
            CHECK_CRITERIA_CMD="python3 src/crawler/scripts/debug_tools/check_issue_criteria.py --issue $issue_num"
        fi
        if ! eval "$CHECK_CRITERIA_CMD"; then
            echo ""
            echo "================================================================================"
            echo "⛔ [PRE-PUSH REJECTED] Issue #$issue_num のアクセプタンスクライテリア（受入基準）に未完了項目があります。"
            echo "すべての受入基準を満たし、Issue 本文のチェックボックス (- [x]) を更新してください。"
            echo "================================================================================"
            echo ""
            exit 1
        fi
        echo "✅ Issue #$issue_num のアクセプタンスクライテリア全件充足を確認しました。"
    fi

    # 5. Pre-PR Local Guardrail (Linter, SonarCloud, Syntax, Branch Hygiene)
    if [ "$SKIP_PRE_PR_CHECK" = "1" ] || [ "$SKIP_PRE_PR_CHECK" = "true" ]; then
        echo "⚠️  SKIP_PRE_PR_CHECK is enabled. Bypassing Pre-PR local guardrail."
    else
        echo "🔍 Pre-PR ローカル高速事前検証 (Linter, SonarCloud, 構文) を実行中..."
        if ! run_pre_pr_check "$branch" "$local_sha"; then
            echo ""
            echo "================================================================================"
            echo "⛔ [PRE-PUSH REJECTED] PR事前検証 (pre_pr_check) でエラーが検出されました。"
            echo "ローカルで問題を解消してから再度プッシュしてください。"
            echo "================================================================================"
            echo ""
            exit 1
        fi
        echo "✅ Pre-PR ローカル高速事前検証に合格しました。"
    fi
done

exit 0
