#!/bin/sh
# .githooks/pre-push
# Enforce GitHub Issue association & SonarCloud local guardrail before pushing to remote

set -e

export MSYS_NO_PATHCONV=1
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-realestate_crawler}"

zero="0000000000000000000000000000000000000000"

run_pre_pr_check() {
    target_branch="$1"
    target_sha="$2"
    toplevel=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    common_dir=$(git rev-parse --git-common-dir 2>/dev/null || echo "$toplevel/.git")
    main_root=$(git -C "$common_dir/.." rev-parse --show-toplevel 2>/dev/null || (cd "$common_dir/.." && pwd -P) 2>/dev/null || echo "$toplevel")

    norm_path() {
        _p=$(echo "$1" | tr '\\' '/')
        case "$_p" in
            [a-zA-Z]:/*)
                _drive=$(echo "$_p" | cut -c1 | tr '[:upper:]' '[:lower:]')
                _p="/${_drive}${_p#[a-zA-Z]:}"
                ;;
            /[a-zA-Z]/*)
                _drive=$(echo "$_p" | cut -c2 | tr '[:upper:]' '[:lower:]')
                _p="/${_drive}${_p#/[a-zA-Z]}"
                ;;
        esac
        echo "$_p"
    }

    toplevel_norm=$(norm_path "$toplevel")
    main_root_norm=$(norm_path "$main_root")
    wt_prefix="$main_root_norm/.worktrees/"

    rel_path=""
    case "$toplevel_norm" in
        "$wt_prefix"*)
            rel_path=".worktrees/${toplevel_norm#"$wt_prefix"}"
            ;;
    esac

    has_working_python3() {
        python3 -c "import sys" >/dev/null 2>&1
    }

    if command -v docker >/dev/null 2>&1; then
        if [ -n "$rel_path" ]; then
            # In-repo worktree mounted under /app/.worktrees/...
            # Its .git file points to a host absolute path, so hand the container-side git dir explicitly.
            wt_git_dir_norm=$(norm_path "$(git rev-parse --absolute-git-dir)")
            rel_git_dir="${wt_git_dir_norm#"$main_root_norm/"}"
            docker compose --project-directory "$main_root" exec -T -e GIT_DIR="/app/$rel_git_dir" -e GIT_WORK_TREE="/app/$rel_path" -w "/app/$rel_path" app python src/crawler/scripts/ops/pre_pr_check.py --diff --skip-coderabbit --branch "$target_branch" --sha "$target_sha"
        elif [ "$toplevel_norm" = "$main_root_norm" ]; then
            # Main checkout mapped to /app
            docker compose --project-directory "$main_root" exec -T app python src/crawler/scripts/ops/pre_pr_check.py --diff --skip-coderabbit --branch "$target_branch" --sha "$target_sha"
        elif has_working_python3; then
            python3 src/crawler/scripts/ops/pre_pr_check.py --diff --skip-coderabbit --branch "$target_branch" --sha "$target_sha"
        else
            # External worktree without host python: run in container mounted volume
            # Also mount shared Git metadata directory as read-only so worktree .git reference resolves
            main_git_dir=$(git rev-parse --git-common-dir 2>/dev/null || echo "")
            if [ -n "$main_git_dir" ] && [ -d "$main_git_dir" ]; then
                main_git_dir_norm=$(norm_path "$main_git_dir")
                wt_git_dir=$(git rev-parse --git-dir 2>/dev/null || echo "")
                wt_git_dir_norm=$(norm_path "$wt_git_dir")
                docker run --rm -v "${toplevel}:/app" -v "${main_git_dir}:${main_git_dir_norm}:ro" -e GIT_DIR="${wt_git_dir_norm}" -e GIT_WORK_TREE=/app -w /app realestate_crawler-app:latest python src/crawler/scripts/ops/pre_pr_check.py --diff --skip-coderabbit --branch "$target_branch" --sha "$target_sha"
            else
                docker run --rm -v "${toplevel}:/app" -w /app realestate_crawler-app:latest python src/crawler/scripts/ops/pre_pr_check.py --diff --skip-coderabbit --branch "$target_branch" --sha "$target_sha"
            fi
        fi
    else
        if python3 -c "import sys; sys.exit(0)" >/dev/null 2>&1; then
            python3 src/crawler/scripts/ops/pre_pr_check.py --diff --skip-coderabbit --branch "$target_branch" --sha "$target_sha"
        else
            python src/crawler/scripts/ops/pre_pr_check.py --diff --skip-coderabbit --branch "$target_branch" --sha "$target_sha"
        fi
    fi
}




while read -r local_ref local_sha remote_ref remote_sha
do
    # Skip branch deletion
    if [ "$local_sha" = "$zero" ]; then
        continue
    fi

    # Only validate branch pushes, allowing tag pushes and other non-branch refs to proceed
    case "$local_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    # Extract branch name from ref
    branch=$(echo "$local_ref" | sed 's#^refs/heads/##')

    # Allow master/production maintenance operations if needed, but enforce for feature/fix branches
    if [ "$branch" = "production" ]; then
        echo ""
        echo "================================================================================"
        echo "⛔ [PRE-PUSH REJECTED] 'production' ブランチへの直接プッシュは禁止されています。"
        echo "================================================================================"
        echo ""
        exit 1
    fi

    if [ "$branch" = "master" ]; then
        continue
    fi

    # 1. Try extracting issue number from branch name (e.g. feature/12-xxx, fix/issue-34-xxx, cursor/fix-312-xxx-c318)
    issue_num=$(echo "$branch" | grep -oE '(issue[-/_]|#)?([0-9]+)' | grep -oE '[0-9]+' | head -n 1 || true)

    # 2. Try extracting issue number from the commit message
    if [ -z "$issue_num" ]; then
        commit_msg=$(git log -1 --pretty=%B "$local_sha" 2>/dev/null || true)
        issue_num=$(echo "$commit_msg" | grep -oE '(#[0-9]+|issue[ -]#[0-9]+|issue[ -][0-9]+)' | grep -oE '[0-9]+' | head -n 1 || true)
    fi

    if [ -z "$issue_num" ]; then
        echo ""
        echo "================================================================================"
        echo "⛔ [PRE-PUSH REJECTED] GitHub Issue が紐付けられていません。"
        echo "ブランチ名またはコミットメッセージに有効な Issue 番号を含めてください。"
        echo ""
        echo "  対象ブランチ: $branch"
        echo ""
        echo "  命名規則の例:"
        echo "    ブランチ名: feature/<issue_num>-<概要> (例: feature/12-add-login)"
        echo "                fix/<issue_num>-<概要>     (例: fix/34-fix-parser)"
        echo "    コミット:   feat: add login (#12)"
        echo ""
        echo "GitHub Issues にチケットを起票後、ブランチ名またはコミットを変更して再実行してください。"
        echo "================================================================================"
        echo ""
        exit 1
    fi

    # 3. Check if the issue exists on GitHub using gh CLI
    if ! command -v gh >/dev/null 2>&1; then
        echo ""
        echo "================================================================================"
        echo "⛔ [PRE-PUSH REJECTED] 'gh' (GitHub CLI) がインストールされていないか、PATHに存在しません。"
        echo "Issue存在確認をバイパスすることは許可されていません。'gh' CLI を導入してください。"
        echo "================================================================================"
        echo ""
        exit 1
    fi

    echo "🔍 Issue #$issue_num の存在を検証中..."
    if ! gh issue view "$issue_num" >/dev/null 2>&1; then
        echo ""
        echo "================================================================================"
        echo "⛔ [PRE-PUSH REJECTED] Issue #$issue_num は GitHub 上に存在しません。"
        echo "GitHub Issues で該当の Issue を作成してからプッシュしてください。"
        echo "================================================================================"
        echo ""
        exit 1
    fi
    echo "✅ Issue #$issue_num の存在を確認しました。"

    # 4. GitHub Issue Acceptance Criteria Guardrail
    echo "🔍 Issue #$issue_num のアクセプタンスクライテリア (受入基準) を検証中..."
    if [ "$SKIP_ISSUE_CHECK" = "1" ] || [ "$SKIP_ISSUE_CHECK" = "true" ] || echo "$branch" | grep -qE '^cursor/'; then
        echo "⚠️  自動化エージェントブランチまたは SKIP_ISSUE_CHECK が有効なため、受入基準ローカル検証をパスします。"
    else
        toplevel=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
        common_dir=$(git rev-parse --git-common-dir 2>/dev/null || echo "$toplevel/.git")
        main_root=$(git -C "$common_dir/.." rev-parse --show-toplevel 2>/dev/null || (cd "$common_dir/.." && pwd -P) 2>/dev/null || echo "$toplevel")

        if command -v docker >/dev/null 2>&1; then
            CHECK_CRITERIA_CMD="docker compose --project-directory \"$main_root\" exec -T app python src/crawler/scripts/debug_tools/check_issue_criteria.py --issue $issue_num"
        else
            CHECK_CRITERIA_CMD="python3 src/crawler/scripts/debug_tools/check_issue_criteria.py --issue $issue_num"
        fi
        if ! eval "$CHECK_CRITERIA_CMD"; then
            echo ""
            echo "================================================================================"
            echo "⛔ [PRE-PUSH REJECTED] Issue #$issue_num のアクセプタンスクライテリア（受入基準）に未完了項目があります。"
            echo "すべての受入基準を満たし、Issue 本文のチェックボックス (- [x]) を更新してください。"
            echo "================================================================================"
            echo ""
            exit 1
        fi
        echo "✅ Issue #$issue_num のアクセプタンスクライテリア全件充足を確認しました。"
    fi

    # 5. Pre-PR Local Guardrail (Linter, SonarCloud, Syntax, Branch Hygiene)
    if [ "$SKIP_PRE_PR_CHECK" = "1" ] || [ "$SKIP_PRE_PR_CHECK" = "true" ]; then
        echo "⚠️  SKIP_PRE_PR_CHECK is enabled. Bypassing Pre-PR local guardrail."
    else
        echo "🔍 Pre-PR ローカル高速事前検証 (SonarCloud, Linter, 構文) を実行中..."
        if ! run_pre_pr_check "$branch" "$local_sha"; then
            echo ""
            echo "================================================================================"
            echo "⛔ [PRE-PUSH REJECTED] PR事前検証 (pre_pr_check: SonarCloud / Linter) でエラーが検出されました。"
            echo "ローカルで問題を解消してから再度プッシュしてください。"
            echo "================================================================================"
            echo ""
            exit 1
        fi
        echo "✅ Pre-PR ローカル高速事前検証に合格しました。"
    fi

    # 6. Host CodeRabbit CLI Guardrail
    if [ "$SKIP_CODERABBIT" = "1" ] || [ "$SKIP_CODERABBIT" = "true" ]; then
        echo "⚠️  SKIP_CODERABBIT is enabled. Bypassing CodeRabbit review guardrail."
    elif ! command -v coderabbit >/dev/null 2>&1; then
        echo ""
        echo "================================================================================"
        echo "⛔ [PRE-PUSH REJECTED] CodeRabbit CLI ('coderabbit') がホスト環境にインストールされていません。"
        echo "インストールするか、緊急時は SKIP_CODERABBIT=1 を指定してプッシュしてください。"
        echo "================================================================================"
        echo ""
        exit 1
    else
        # Verify current checkout matches the commit being pushed
        current_head=$(git rev-parse HEAD 2>/dev/null || echo "")
        if [ -z "$local_sha" ] || [ -z "$current_head" ] || [ "$current_head" != "$local_sha" ]; then
            echo ""
            echo "================================================================================"
            echo "⛔ [PRE-PUSH REJECTED] チェックアウト中のコミット ($current_head) とプッシュ対象 ($local_sha) が一致しません、または解決できませんでした。"
            echo "CodeRabbit CLI はチェックアウト中の作業ツリーをレビューするため、プッシュ対象をチェックアウトしてからプッシュしてください。"
            echo "================================================================================"
            echo ""
            exit 1
        fi

        # 1 PR につきローカルでの CodeRabbit レビューは 1 回で OK (キャッシュチェック)
        cr_branch_clean=$(echo "$branch" | tr '/\\' '__')
        toplevel=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
        cr_cache_dir="$toplevel/.coderabbit_cache"
        cr_cache_file="$cr_cache_dir/${cr_branch_clean}.reviewed"
        if [ -f "$cr_cache_file" ]; then
            echo "✅ CodeRabbit CLI: 本PRブランチ ($branch) で既にレビュー完了済みのためスキップします。"
        else
            echo "🔍 CodeRabbit CLI によるローカル AI コードレビューを実行中..."
            # Resolve merge-base for pushed commit to ensure clean review of committed changes
            cr_base=$(git merge-base origin/master "$local_sha" 2>/dev/null || git merge-base master "$local_sha" 2>/dev/null || echo "origin/master")
            CR_CMD="coderabbit review --agent --base-commit $cr_base --committed"

            # Execute with finite timeout (1800s) ensuring set -e does not abort before reporting
            if command -v timeout >/dev/null 2>&1; then
                if CR_OUTPUT=$(timeout 1800s $CR_CMD 2>&1); then
                    CR_EXIT_CODE=0
                else
                    CR_EXIT_CODE=$?
                fi
            else
                echo ""
                echo "================================================================================"
                echo "⛔ [PRE-PUSH REJECTED] 有限時間タイムアウトコマンド ('timeout') が環境に存在しません。"
                echo "無限待機（ハング）を防止するため、timeout コマンドを導入するか、SKIP_CODERABBIT=1 を指定してください。"
                echo "================================================================================"
                echo ""
                exit 1
            fi

            CR_FINDINGS=$(echo "$CR_OUTPUT" | grep -oE '"type"[[:space:]]*:[[:space:]]*"finding"' | wc -l || echo "0")
            CR_ERRORS=$(echo "$CR_OUTPUT" | grep -E '"(severity)"[[:space:]]*:[[:space:]]*"(high|critical|error|major)"' || true)

            if [ "$CR_EXIT_CODE" -ne 0 ] || echo "$CR_OUTPUT" | grep -qE '"type"[[:space:]]*:[[:space:]]*"error"'; then
                CR_ERR_MSG=$(echo "$CR_OUTPUT" | grep -oE '"message"[[:space:]]*:[[:space:]]*"[^"]+"' | head -n 1 || echo "$CR_OUTPUT")
                if echo "$CR_OUTPUT" | grep -qE '"errorType"[[:space:]]*:[[:space:]]*"rate_limit"' || echo "$CR_OUTPUT" | grep -qi 'rate limit'; then
                    echo ""
                    echo "================================================================================"
                    echo "⚠️  [PRE-PUSH WARNING] CodeRabbit CLI の利用制限（Rate limit / Monthly limit）を検知しました。"
                    echo "  $CR_ERR_MSG"
                    echo "ユーザー指示規則に従い、ローカルレビューをスキップしてプッシュを続行します（PR上のCIで評価されます）。"
                    echo "================================================================================"
                    echo ""
                    mkdir -p "$cr_cache_dir" 2>/dev/null || true
                    echo "rate_limited" > "$cr_cache_file" 2>/dev/null || true
                else
                    echo ""
                    echo "================================================================================"
                    echo "⛔ [PRE-PUSH REJECTED] CodeRabbit CLI レビューでエラーが発生しました (exit code: $CR_EXIT_CODE)。"
                    echo "  $CR_ERR_MSG"
                    echo "================================================================================"
                    echo ""
                    exit 1
                fi
            elif [ -n "$CR_ERRORS" ]; then
                echo ""
                echo "================================================================================"
                echo "⛔ [PRE-PUSH REJECTED] CodeRabbit CLI より重大な指摘（Major / High / Critical）が検出されました。"
                echo "指摘内容を解消してから再度プッシュしてください。"
                echo "$CR_ERRORS"
                echo "================================================================================"
                echo ""
                exit 1
            else
                echo "✅ CodeRabbit CLI レビューに合格しました (指摘: ${CR_FINDINGS}件)。"
                mkdir -p "$cr_cache_dir" 2>/dev/null || true
                echo "reviewed" > "$cr_cache_file" 2>/dev/null || true
            fi
        fi
    fi
done

exit 0

